# Web Push (VAPID). Private key는 frontend에 넣지 말 것.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://gomnastudio.com

# 로컬/수동 테스트 발송. production UI에 노출하지 말 것.
PUSH_DEV_SECRET=

# 매일 발송 scheduler가 호출할 때 사용.
PUSH_CRON_SECRET=

# 오늘의 말씀 이메일 (Resend). API key는 frontend에 넣지 말 것.
RESEND_API_KEY=
MAIL_FROM=은혜의말씀 <beth.t@example.com>
MAIL_APP_ORIGIN=http://127.0.0.1:8000
MAIL_UNSUB_SECRET=
MAIL_CRON_SECRET=
MAIL_DEV_SECRET=
